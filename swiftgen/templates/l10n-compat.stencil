  {{accessModifier}} static func {{localKey|swiftIdentifier:"pretty"|lowerFirstWord|escapeReservedKeywords}}({% call parametersBlock string.types %}) -> String {
    return L10n.tr("{{table}}", "{{string.key}}", {%+ call argumentsBlock string.types %}, fallback: "{{translation}}")
  }
  {% else %}
  {{accessModifier}} static var {{localKey|swiftIdentifier:"pretty"|lowerFirstWord|escapeReservedKeywords}}: String {
    L10n.tr("{{table}}", "{{string.key}}", fallback: "{{translation}}")
