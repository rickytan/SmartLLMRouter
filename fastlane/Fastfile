# frozen_string_literal: true

opt_out_usage

# SmartLLMRouter Fastfile
# fastlane runs from fastlane/ — all commands prefixed with cd to project root

default_platform(:mac)

ROOT = File.expand_path("..", __dir__)
PROJECT_NAME = "SmartLLMRouter"
SCHEME       = "SmartLLMRouter"
WORKSPACE    = "#{PROJECT_NAME}.xcworkspace"
ENTITLEMENTS = "Resources/#{PROJECT_NAME}.entitlements"
APP_NAME     = "#{PROJECT_NAME}.app"

require 'shellwords'

def run(*args)
  cmd = if args.length == 1
          "cd #{ROOT} && #{args.first}"
        else
          "cd #{ROOT} && #{args.map { |a| Shellwords.escape(a) }.join(' ')}"
        end
  FastlaneCore::CommandExecutor.execute(command: cmd, print_all: true, print_command: true)
end

def root_path(path)
  File.join(ROOT, path)
end

def app_version
  tag = ENV["GITHUB_REF"]&.then { |r| r.sub(%r{^refs/tags/}, "") }
  tag ||= `cd #{ROOT} && git describe --tags --exact-match 2>/dev/null`.strip
  tag = tag.sub(/^v/, "")
  return tag unless tag.empty?
  yml = File.read(root_path("project.yml"))
  yml[/MARKETING_VERSION:\s*(\S+)/, 1] || "0.0.0"
end

def code_sign_identity
  ENV["CODE_SIGN_IDENTITY"] || ENV["CODE_SIGN_IDENTITY_NAME"] || ENV["DEVELOPER_ID_APPLICATION"] ||
    (app_store_connect_key_available? ? "Developer ID Application" : nil)
end

def signed_build?
  identity = code_sign_identity
  identity && !identity.empty? && identity != "-"
end

def app_store_connect_key_available?
  key_id = ENV["APPLE_KEY_ID"] || ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
  issuer_id = ENV["APPLE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
  key_content = ENV["APPLE_KEY_CONTENT"] || ENV["APP_STORE_CONNECT_API_KEY_KEY"]
  [key_id, issuer_id, key_content].all? { |v| v && !v.to_s.empty? }
end

def app_store_connect_key
  return nil unless app_store_connect_key_available?

  @app_store_connect_key ||= app_store_connect_api_key(
    key_id: ENV["APPLE_KEY_ID"] || ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APPLE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_content: ENV["APPLE_KEY_CONTENT"] || ENV["APP_STORE_CONNECT_API_KEY_KEY"],
    is_key_content_base64: ENV["APPLE_KEY_CONTENT_BASE64"].to_s == "true" ||
      ENV["APP_STORE_CONNECT_API_KEY_IS_KEY_CONTENT_BASE64"].to_s == "true"
  )
end

def is_prerelease?
  app_version.match?(/alpha|beta|rc/i)
end

# ── Build ──
lane :build do
  run("xcodegen", "generate")

  if File.exist?(root_path("Gemfile.lock"))
    cocoapods(use_bundle_exec: true)
  else
    cocoapods(use_bundle_exec: false)
  end

  if system("command -v swiftgen &>/dev/null")
    run("swiftgen", "config", "run")
  else
    UI.important("SwiftGen not installed -- skipping")
  end

  # match fetches Developer ID cert from git repo (if configured)
  if signed_build?
    identity = code_sign_identity
    match_options = {
      type: "developer_id",
      app_identifier: "com.smartllmrouter.app",
      platform: "macos",
      readonly: true
    }
    match_options[:api_key] = app_store_connect_key if app_store_connect_key_available?
    match_options[:team_id] = ENV["APPLE_TEAM_ID"] if ENV["APPLE_TEAM_ID"]&.then { |v| !v.empty? }
    match_options[:git_basic_authorization] = ENV["MATCH_GIT_BASIC_AUTHORIZATION"] if ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    match(match_options)
    UI.header("Building #{PROJECT_NAME} (signing: #{identity})")
    gym(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      destination: "platform=macOS,arch=arm64",
      skip_package_ipa: true,
      skip_archive: true,
      export_method: "developer-id",
      xcargs: "ONLY_ACTIVE_ARCH=NO",
      output_directory: "build",
      silent: false
    )
  else
    UI.header("Building #{PROJECT_NAME} (signing: ad-hoc)")
    gym(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      destination: "platform=macOS,arch=arm64",
      skip_package_ipa: true,
      skip_archive: true,
      skip_codesigning: true,
      xcargs: "CODE_SIGN_IDENTITY='-' " \
              "CODE_SIGNING_REQUIRED=NO " \
              "CODE_SIGNING_ALLOWED=NO " \
              "ONLY_ACTIVE_ARCH=NO",
      output_directory: "build",
      silent: false
    )
  end

  built_products_dir = FastlaneCore::CommandExecutor.execute(
    command: "cd #{ROOT} && xcodebuild -workspace '#{WORKSPACE}' -scheme '#{SCHEME}' " \
             "-configuration Release -destination 'platform=macOS,arch=arm64' " \
             "-showBuildSettings 2>/dev/null | " \
             "awk -F' = ' '/^[[:space:]]+BUILT_PRODUCTS_DIR/ {print $2; exit}'",
    print_all: false,
    print_command: false
  ).strip

  UI.important("BUILT_PRODUCTS_DIR: #{built_products_dir}")

  build_dir = root_path("build")
  FileUtils.mkdir_p(build_dir)
  FileUtils.rm_rf(File.join(build_dir, APP_NAME))
  run("ditto", "#{built_products_dir}/#{APP_NAME}", "build/#{APP_NAME}")

  dsym_src = "#{built_products_dir}/#{APP_NAME}.dSYM"
  if Dir.exist?(dsym_src)
    FileUtils.rm_rf(File.join(build_dir, "#{APP_NAME}.dSYM"))
    run("ditto", dsym_src, "build/#{APP_NAME}.dSYM")
  end

  # Deep codesign all nested binaries (Sparkle XPC services, etc.)
  if signed_build?
    identity = code_sign_identity
    app_path = root_path("build/#{APP_NAME}")
    frameworks_dir = "#{app_path}/Contents/Frameworks"
    UI.important("Deep codesign: identity=#{identity}, frameworks_dir=#{frameworks_dir}, exist=#{Dir.exist?(frameworks_dir)}")
    if Dir.exist?(frameworks_dir)
      # 1. Sign standalone binaries inside frameworks (e.g. Autoupdate)
      Dir.glob("#{frameworks_dir}/**/Versions/B/*").each do |f|
        next if f.end_with?(".xpc") || f.end_with?(".framework") || File.directory?(f)
        next if File.basename(f) == "Headers"  # skip Headers dir
        UI.important("Deep codesign: signing binary #{File.basename(f)}")
        run("codesign", "--force", "--sign", identity, "--timestamp", "--options", "runtime", f)
      end
      # 2. Sign XPC services
      xpcs = Dir.glob("#{frameworks_dir}/**/*.xpc")
      UI.important("Deep codesign: found #{xpcs.length} xpc bundles: #{xpcs.map { |x| File.basename(x) }}")
      xpcs.each do |xpc|
        run("codesign", "--force", "--sign", identity, "--timestamp", "--options", "runtime", xpc)
      end
      # 3. Sign nested .app bundles (e.g. Updater.app)
      apps = Dir.glob("#{frameworks_dir}/**/*.app")
      UI.important("Deep codesign: found #{apps.length} app bundles: #{apps.map { |a| File.basename(a) }}")
      apps.each do |app|
        run("codesign", "--force", "--sign", identity, "--timestamp", "--options", "runtime", app)
      end
      # 4. Sign frameworks (outermost last)
      fws = Dir.glob("#{frameworks_dir}/**/*.framework")
      UI.important("Deep codesign: found #{fws.length} frameworks: #{fws.map { |f| File.basename(f) }}")
      fws.each do |fw|
        run("codesign", "--force", "--sign", identity, "--timestamp", "--options", "runtime", fw)
      end
    end
  end

  UI.success("Build complete: build/#{APP_NAME}")
end

# ── DMG ──
lane :dmg do
  app_path = root_path("build/#{APP_NAME}")
  UI.user_error!("#{app_path} not found -- run `fastlane build` first") unless Dir.exist?(app_path)

  version = app_version
  dmg_name = "#{PROJECT_NAME}-#{version}.dmg"
  artifacts_dir = root_path("release-artifacts")
  FileUtils.mkdir_p(artifacts_dir)

  UI.header("Packaging DMG: #{dmg_name}")

  staging = "#{Dir.mktmpdir}/dmg-staging"
  FileUtils.mkdir_p(staging)
  run("cp", "-R", "build/#{APP_NAME}", "#{staging}/")
  FileUtils.ln_s("/Applications", "#{staging}/Applications")

  dmg_path = File.join(artifacts_dir, dmg_name)
  run("hdiutil", "create", "-volname", "#{PROJECT_NAME} #{version}",
      "-srcfolder", staging, "-ov", "-format", "UDZO", dmg_path)

  identity = code_sign_identity || "-"
  run("codesign", "--force", "--sign", identity, dmg_path)
  run("codesign", "--verify", "--verbose", dmg_path)

  dsym = root_path("build/#{APP_NAME}.dSYM")
  if Dir.exist?(dsym)
    dsym_zip = File.join(artifacts_dir, "#{PROJECT_NAME}-#{version}.dSYM.zip")
    zip(path: "build/#{APP_NAME}.dSYM", output_path: dsym_zip)
    UI.success("dSYM packaged: #{dsym_zip}")
  end

  FileUtils.rm_rf(staging)
  UI.success("DMG created: #{dmg_path}")
end

# ── Notarize ──
lane :notarize_dmg do
  apple_id_val   = ENV["APPLE_ID"]
  apple_password = ENV["APPLE_APP_SPECIFIC_PASSWORD"] || ENV["FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD"]
  team_id_val    = ENV["APPLE_TEAM_ID"]

  version  = app_version
  dmg_name = "#{PROJECT_NAME}-#{version}.dmg"
  dmg_path = root_path("release-artifacts/#{dmg_name}")
  UI.user_error!("#{dmg_path} not found -- run `fastlane dmg` first") unless File.exist?(dmg_path)

  if app_store_connect_key_available?
    key_id     = ENV["APPLE_KEY_ID"] || ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    issuer_id  = ENV["APPLE_ISSUER_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_content = ENV["APPLE_KEY_CONTENT"] || ENV["APP_STORE_CONNECT_API_KEY_KEY"]

    key_file = root_path("auth_key_#{key_id}.p8")
    File.write(key_file, key_content.gsub("\\n", "\n"))

    begin
      output = run("xcrun", "notarytool", "submit", dmg_path,
          "--key", key_file,
          "--key-id", key_id,
          "--issuer", issuer_id,
          "--wait")
    ensure
      FileUtils.rm_f(key_file)
    end
  else
    [apple_id_val, apple_password, team_id_val].each { |v| UI.user_error!("Missing required notarization env var") if v.nil? || v.empty? }
    output = run("xcrun", "notarytool", "submit", dmg_path,
        "--apple-id", apple_id_val,
        "--password", apple_password,
        "--team-id", team_id_val,
        "--wait")
  end

  # Check for failure and fetch detailed log
  if output.to_s.include?("status: Invalid") || $?.exitstatus != 0
    submission_id = output.to_s[/id:\s+([a-f0-9-]+)/, 1]
    if submission_id
      UI.important("Notarization failed. Fetching log for submission #{submission_id}...")
      log_cmd = app_store_connect_key_available? ?
        "xcrun notarytool log #{submission_id} --key #{key_file} --key-id #{ENV['APPLE_KEY_ID']} --issuer #{ENV['APPLE_ISSUER_ID']}" :
        "xcrun notarytool log #{submission_id} --apple-id #{apple_id_val} --password #{apple_password} --team-id #{team_id_val}"
      log_output = `#{log_cmd} 2>&1`
      UI.error("=== Notarization Log ===")
      UI.error(log_output)
      UI.user_error!("Notarization rejected — see log above")
    end
  end

  run("xcrun", "stapler", "staple", dmg_path)
  UI.success("Notarized & stapled: #{dmg_path}")
end

# ── Appcast ──
lane :appcast do
  ed_key = ENV["SPARKLE_ED_PRIVATE_KEY"]
  UI.user_error!("Set SPARKLE_ED_PRIVATE_KEY env var") if ed_key.nil? || ed_key.empty?

  sparkle_ver = "2.6.4"
  sparkle_dir = root_path("sparkle-bin")
  generate_appcast = "#{sparkle_dir}/bin/generate_appcast"

  unless File.exist?(generate_appcast)
    UI.header("Downloading Sparkle #{sparkle_ver}...")
    FileUtils.mkdir_p(sparkle_dir)
    run("curl", "-fsSL",
        "https://github.com/sparkle-project/Sparkle/releases/download/#{sparkle_ver}/Sparkle-#{sparkle_ver}.tar.xz",
        "-o", "sparkle-bin/sparkle.tar.xz")
    run("tar", "xf", "sparkle-bin/sparkle.tar.xz", "-C", "sparkle-bin")
    FileUtils.chmod("+x", generate_appcast)
  end

  key_file = root_path("sparkle_private.pem")
  File.write(key_file, ed_key)

  repo = ENV["GITHUB_REPOSITORY"] || "rickytan/SmartLLMRouter"
  download_prefix = "https://github.com/#{repo}/releases/download/"

  UI.header("Generating Appcast...")
  run(generate_appcast, "--ed-key-file", "sparkle_private.pem",
      "--download-url-prefix", download_prefix,
      "--link", "https://github.com/#{repo}", "release-artifacts/")

  FileUtils.rm_f(key_file)
  UI.success("Appcast generated: release-artifacts/appcast.xml")
end

# ── Full Release ──
lane :release do
  # Create a temporary keychain to prevent codesign UI permission popups in CI
  create_keychain(
    name: "fastlane_tmp_keychain",
    password: ENV["MATCH_PASSWORD"],
    default_keychain: true,
    unlock: true,
    timeout: 3600
  )

  if signed_build?
    # match fetches Developer ID cert from git repo
    match_options = {
      type: "developer_id",
      app_identifier: "com.smartllmrouter.app",
      platform: "macos",
      readonly: true
    }
    match_options[:api_key] = app_store_connect_key if app_store_connect_key_available?
    match_options[:team_id] = ENV["APPLE_TEAM_ID"] if ENV["APPLE_TEAM_ID"]&.then { |v| !v.empty? }
    match_options[:git_basic_authorization] = ENV["MATCH_GIT_BASIC_AUTHORIZATION"] if ENV["MATCH_GIT_BASIC_AUTHORIZATION"]
    match(match_options)
  end

  build

  dmg

  if signed_build?
    notarize_dmg
  else
    UI.important("Skipping notarization (ad-hoc build)")
  end

  if signed_build?
    appcast
  end

  UI.success("Release #{app_version} complete!")
ensure
  delete_keychain(name: "fastlane_tmp_keychain")
end

# ── Dry-run (local testing) ──
lane :release_test do
  ENV["CODE_SIGN_IDENTITY"] ||= "-"
  build
  dmg
  UI.success("Test DMG ready at release-artifacts/")
end
