{
  "openapi": "3.1.0",
  "info": {
    "title": "Anthropic Messages API",
    "version": "2023-06-01",
    "description": "The Messages API allows you to send a list of messages and receive a response from Claude."
  },
  "paths": {
    "/v1/messages": {
      "post": {
        "operationId": "createMessage",
        "summary": "Create a message",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MessageRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string",
                  "description": "Server-Sent Events stream."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MessageRequest": {
        "type": "object",
        "properties": {
          "model": { "type": "string", "description": "The model that will complete your prompt. e.g., claude-3-opus-20240229" },
          "max_tokens": { "type": "integer", "description": "The maximum number of tokens to generate before stopping." },
          "system": {
            "description": "System prompt. Can be a string or an array of content blocks.",
            "oneOf": [
              { "type": "string" },
              {
                "type": "array",
                "items": { "$ref": "#/components/schemas/SystemContentBlock" }
              }
            ]
          },
          "messages": {
            "type": "array",
            "description": "Array of Message objects.",
            "items": { "$ref": "#/components/schemas/MessageParam" },
            "minItems": 1
          },
          "temperature": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
          "top_p": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
          "top_k": { "type": "integer", "minimum": 0 },
          "stop_sequences": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
          "stream": { "type": "boolean", "default": false },
          "tools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ToolDefinition" }
          },
          "tool_choice": { "$ref": "#/components/schemas/ToolChoice" }
        },
        "required": ["model", "max_tokens", "messages"]
      },
      "MessageParam": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant"] },
          "content": { "$ref": "#/components/schemas/MessageContent" }
        },
        "required": ["role", "content"]
      },
      "MessageContent": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ContentBlockParam" }
          }
        ]
      },
      "SystemContentBlock": {
        "oneOf": [
          { "type": "string" },
          { "$ref": "#/components/schemas/TextBlock" },
          { "$ref": "#/components/schemas/CacheControlBlock" }
        ]
      },
      "ContentBlockParam": {
        "oneOf": [
          { "$ref": "#/components/schemas/TextBlock" },
          { "$ref": "#/components/schemas/ImageBlock" },
          { "$ref": "#/components/schemas/ToolUseBlock" },
          { "$ref": "#/components/schemas/ToolResultBlock" },
          { "$ref": "#/components/schemas/CacheControlBlock" }
        ]
      },
      "TextBlock": {
        "type": "object",
        "properties": {
          "type": { "const": "text" },
          "text": { "type": "string" },
          "cache_control": { "$ref": "#/components/schemas/CacheControl" }
        },
        "required": ["type", "text"]
      },
      "ImageBlock": {
        "type": "object",
        "properties": {
          "type": { "const": "image" },
          "source": { "$ref": "#/components/schemas/ImageSource" },
          "cache_control": { "$ref": "#/components/schemas/CacheControl" }
        },
        "required": ["type", "source"]
      },
      "ImageSource": {
        "type": "object",
        "properties": {
          "type": { "const": "base64" },
          "media_type": { "type": "string", "enum": ["image/jpeg", "image/png", "image/gif", "image/webp"] },
          "data": { "type": "string" }
        },
        "required": ["type", "media_type", "data"]
      },
      "ToolUseBlock": {
        "type": "object",
        "properties": {
          "type": { "const": "tool_use" },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "input": {
            "type": "object",
            "description": "The input to the tool. Must match the tool's input schema."
          }
        },
        "required": ["type", "id", "name", "input"]
      },
      "ToolResultBlock": {
        "type": "object",
        "properties": {
          "type": { "const": "tool_result" },
          "tool_use_id": { "type": "string" },
          "content": { "$ref": "#/components/schemas/MessageContent" },
          "is_error": { "type": "boolean" }
        },
        "required": ["type", "tool_use_id", "content"]
      },
      "CacheControlBlock": {
        "type": "object",
        "properties": {
          "type": { "const": "text" },
          "text": { "type": "string" },
          "cache_control": { "$ref": "#/components/schemas/CacheControl" }
        },
        "required": ["type", "text", "cache_control"]
      },
      "CacheControl": {
        "type": "object",
        "properties": {
          "type": { "const": "ephemeral" }
        },
        "required": ["type"]
      },
      "ToolDefinition": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "input_schema": {
            "type": "object",
            "format": "json-schema",
            "description": "JSON Schema defining the input parameters for the tool."
          },
          "cache_control": { "$ref": "#/components/schemas/CacheControl" }
        },
        "required": ["name", "input_schema"]
      },
      "ToolChoice": {
        "oneOf": [
          { "type": "string", "enum": ["auto", "any", "none"] },
          { "$ref": "#/components/schemas/ToolChoiceSpecific" }
        ]
      },
      "ToolChoiceSpecific": {
        "type": "object",
        "properties": {
          "type": { "const": "tool" },
          "name": { "type": "string" }
        },
        "required": ["type", "name"]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "const": "message" },
          "role": { "const": "assistant" },
          "model": { "type": "string" },
          "content": {
            "type": "array",
            "items": {
              "oneOf": [
                { "$ref": "#/components/schemas/TextBlock" },
                { "$ref": "#/components/schemas/ToolUseBlock" }
              ]
            }
          },
          "stop_reason": {
            "type": "string",
            "enum": ["end_turn", "max_tokens", "stop_sequence", "tool_use"]
          },
          "stop_sequence": { "type": ["string", "null"] },
          "usage": { "$ref": "#/components/schemas/Usage" }
        },
        "required": ["id", "type", "role", "model", "content", "stop_reason", "usage"]
      },
      "Usage": {
        "type": "object",
        "properties": {
          "input_tokens": { "type": "integer" },
          "cache_creation_input_tokens": { "type": "integer" },
          "cache_read_input_tokens": { "type": "integer" },
          "output_tokens": { "type": "integer" }
        },
        "required": ["input_tokens", "output_tokens"]
      },
      "StreamEvent": {
        "description": "A server-sent event payload.",
        "oneOf": [
          { "$ref": "#/components/schemas/MessageStartEvent" },
          { "$ref": "#/components/schemas/MessageDeltaEvent" },
          { "$ref": "#/components/schemas/ContentBlockStartEvent" },
          { "$ref": "#/components/schemas/ContentBlockDeltaEvent" },
          { "$ref": "#/components/schemas/ContentBlockStopEvent" },
          { "$ref": "#/components/schemas/MessageStopEvent" },
          { "$ref": "#/components/schemas/PingEvent" },
          { "$ref": "#/components/schemas/ErrorEvent" }
        ]
      },
      "MessageStartEvent": {
        "type": "object",
        "properties": {
          "type": { "const": "message_start" },
          "message": { "$ref": "#/components/schemas/MessageResponse" }
        }
      },
      "MessageDeltaEvent": {
        "type": "object",
        "properties": {
          "type": { "const": "message_delta" },
          "delta": { "$ref": "#/components/schemas/MessageDelta" },
          "usage": { "$ref": "#/components/schemas/UsageDelta" }
        }
      },
      "MessageDelta": {
        "type": "object",
        "properties": {
          "stop_reason": { "type": ["string", "null"] },
          "stop_sequence": { "type": ["string", "null"] }
        }
      },
      "UsageDelta": {
        "type": "object",
        "properties": {
          "output_tokens": { "type": "integer" }
        }
      },
      "ContentBlockStartEvent": {
        "type": "object",
        "properties": {
          "type": { "const": "content_block_start" },
          "index": { "type": "integer" },
          "content_block": {
            "oneOf": [
              { "$ref": "#/components/schemas/TextBlock" },
              { "$ref": "#/components/schemas/ToolUseBlock" }
            ]
          }
        }
      },
      "ContentBlockDeltaEvent": {
        "type": "object",
        "properties": {
          "type": { "const": "content_block_delta" },
          "index": { "type": "integer" },
          "delta": { "$ref": "#/components/schemas/ContentBlockDelta" }
        }
      },
      "ContentBlockDelta": {
        "oneOf": [
          { "$ref": "#/components/schemas/TextDelta" },
          { "$ref": "#/components/schemas/InputJsonDelta" }
        ]
      },
      "TextDelta": {
        "type": "object",
        "properties": { "type": { "const": "text_delta" }, "text": { "type": "string" } }
      },
      "InputJsonDelta": {
        "type": "object",
        "properties": { "type": { "const": "input_json_delta" }, "partial_json": { "type": "string" } }
      },
      "ContentBlockStopEvent": {
        "type": "object",
        "properties": { "type": { "const": "content_block_stop" }, "index": { "type": "integer" } }
      },
      "MessageStopEvent": {
        "type": "object",
        "properties": { "type": { "const": "message_stop" } }
      },
      "PingEvent": {
        "type": "object",
        "properties": { "type": { "const": "ping" } }
      },
      "ErrorEvent": {
        "type": "object",
        "properties": { "type": { "const": "error" }, "error": { "$ref": "#/components/schemas/ApiError" } }
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
